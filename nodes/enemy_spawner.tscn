[sub_resource type="GDScript" id="GDScript_1uc5m"]
resource_name = "enemy_spawner"
script/source = "extends Node3D

@export var scene:PackedScene
@export var time: float = 30.0:
	set(value):
		time = value
		if timer:
			timer.wait_time = time

@export var max_enemies_spawned:int = 5

var enemies_spawned:int = 0

@onready var timer: Timer = $Timer

func _ready() -> void:
	timer.wait_time = time
	timer.timeout.connect(spawn_enemy)
	

func spawn_enemy():
	if enemies_spawned < max_enemies_spawned:
		var enemy :AIAgent= scene.instantiate()
		enemy.tree_exiting.connect(reduce_enemy_count)
		if enemy.target == null:
			enemy.target = get_tree().root.find_children(\"PlayerCharacter\",\"CharacterBody3D\",true,false)[0]
		enemy.global_position = self.global_position
		get_tree().root.add_child(enemy)
		enemies_spawned += 1

func reduce_enemy_count():
	print(\"reduce spwan count\")
	enemies_spawned -= 1
"

