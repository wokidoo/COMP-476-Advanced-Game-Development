[sub_resource type="GDScript" id="GDScript_oerex"]
resource_name = "idle"
script/source = "@tool
extends State

@export var agent:AIAgent

func state_enter() -> void:
	for c in get_children():
		c.process_mode = Node.PROCESS_MODE_INHERIT

func state_exit() -> void:
	for c in get_children():
		c.process_mode = Node.PROCESS_MODE_DISABLED

func state_physics_process(_delta: float) -> void:
	if agent.target:
		state_machine.execute_event('seek')
"

[sub_resource type="GDScript" id="GDScript_y06na"]
resource_name = "seek"
script/source = "@tool
extends State

@export var agent:AIAgent
@export var seek_force: float = 1.0
@export var avoider_component:AvoiderComponent

@export var cutoff_distance:float = 2.5

var distance_to_target:float = 0.0
var facing_target:float = 0.0

var path:Array[NavigationNode3D]
var _current_node:NavigationNode3D
var _current_node_idx:int

func state_enter() -> void:
	path = NavigationUtil.find_path(agent.navigation_root,agent.global_position,agent.target.global_position)
	_current_node_idx = 0
	_current_node = path[_current_node_idx]
	for c in get_children():
		c.process_mode = Node.PROCESS_MODE_INHERIT

func state_exit() -> void:
	for c in get_children():
		c.process_mode = Node.PROCESS_MODE_DISABLED

func state_physics_process(_delta: float) -> void:
	if not agent.target or agent.target.global_position.distance_to(agent.global_position) < 2:
		state_machine.execute_event('idle')
		return
	if _current_node and _current_node.overlaps_body(agent):
		_current_node_idx += 1
		if _current_node_idx >= path.size():
			_current_node = null
			return
		_current_node = path[_current_node_idx]
	
	var target_direction :Vector3= Vector3.ZERO 
	if _current_node:
		target_direction = (_current_node.get_world_position() - agent.global_position)
	else:
		target_direction = (agent.target.global_position - agent.global_position)
		
	distance_to_target = target_direction.length()
	target_direction = target_direction.slide(Vector3.UP).normalized()
	facing_target = agent.get_facing_target_factor(target_direction)
	
	AIUtils.AIActions.look_in_direction(agent,target_direction,seek_force)

	if distance_to_target > cutoff_distance and facing_target > 0.95:
		AIUtils.AIActions.move_forward(agent,seek_force)
	elif avoider_component.is_avoiding() and facing_target < 0.95:
		AIUtils.AIActions.move_forward(agent,seek_force)

func reached_navigation_node(nav_node:NavigationNode3D) -> bool:
	return nav_node.get_distance_to_position(agent.global_position) <= 1.0
"

