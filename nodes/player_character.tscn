resource_name = "footsteps_sound"
script/source = "extends AudioStreamPlayer3D

@export var animation_tree:AnimationTree

func _process(delta: float) -> void:
	var blend_amount:float = animation_tree.get(\"parameters/moving_blend/blend_position\")
	if blend_amount >= 0.1:
		pitch_scale = blend_amount
		stream_paused = false
	else:
		stream_paused = true
"

