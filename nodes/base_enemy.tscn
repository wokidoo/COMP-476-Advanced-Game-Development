[sub_resource type="GDScript" id="GDScript_0ih3i"]
resource_name = "base_enemy_animation_tree"
script/source = "extends AnimationTree

@export var agent:AIAgent

func _physics_process(_delta: float) -> void:
	var h_velocity:Vector3 = agent.velocity
	h_velocity.y = 0.0
	var _v_velocity:float = agent.velocity.y
	
	var speed_blend:float = h_velocity.length()/agent.walk_speed
	if agent.is_on_floor():
		self.set('parameters/moving_animation_blend/blend_position',speed_blend)
		self['parameters/playback'].travel('moving_animation_blend')
	else:
		self['parameters/playback'].travel('Jump_mixamo_com')
"

