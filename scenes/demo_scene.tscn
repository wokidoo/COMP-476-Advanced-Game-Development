[sub_resource type="GDScript" id="GDScript_5q064"]
resource_name = "healthDebug"
script/source = "extends Node3D

@export var agents:Array[AIAgent]
@export var player:Player3D

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func _input(event: InputEvent) -> void:
	if event is InputEventKey:
		if event.pressed and event.keycode == KEY_X:
			for agent in agents:
				var hc = agent.health_component
				hc._set_health(hc.health - 0.5)
		if event.pressed and event.keycode == KEY_Z:
			var hc = player.health_component
			hc._set_health(hc.health - 0.5)
	
"

